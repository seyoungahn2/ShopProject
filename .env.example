# LLM API (OpenAI 호환 API도 사용 가능)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# NewsAPI (선택, https://newsapi.org)
NEWSAPI_KEY=

# 보고서 출력 형식 (쉼표 구분): markdown, xlsx, csv
REPORT_FORMATS=markdown,xlsx,csv

# 에이전트 설정
DATA_DIR=./data
REPORTS_DIR=./reports
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
TIMEZONE=Asia/Seoul

# Google Sheets 자동 업로드 (선택)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
